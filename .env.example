APP_NAME=DHARM YT PRO
APP_ENV=development

# SQLite works for local testing; use PostgreSQL in production
DATABASE_URL=sqlite:///data/dharm_yt.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dharm_yt

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/callback
# Quota ledger name (Google Cloud project id); empty = "default"
GOOGLE_CLOUD_PROJECT=

GOOGLE_DRIVE_CREDENTIALS=

# To generate: python scripts/generate_key.py
TOKEN_ENCRYPTION_KEY=
BACKEND_SECRET_KEY=

# VPN (Phase 9, optional): one WireGuard config per channel profile, as WG_CONF_<PROFILE>.
# On GitHub use secrets (WG_CONF_CH01, WG_CONF_CH02, ...). Locally you may export them in your shell;
# never paste a real config into a committed file.
# WG_CONF_CH01=

GITHUB_REPOSITORY=dharm09876543-gif/DHARM-YT-PRO

# Telegram alerts (optional): a phone message when an upload succeeds / fails
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini AI: auto-generate title, description, tags (Phase 6+)
GEMINI_API_KEY=
